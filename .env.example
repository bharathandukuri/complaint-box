# ─────────────────────────────────────────────────────────────────────────────
# RCE Complaint Box — Environment Variables Template
#
# Copy this file to .env and fill in your values before running Docker.
# NEVER commit .env — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Docker Compose: use "mongo" (the service name) as host.
# Production (MongoDB Atlas): mongodb+srv://user:pass@cluster.mongodb.net/complaint_box
MONGODB_URI=mongodb://mongo:27017/complaint_box

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_BASE64_SECRET
# Token expiry in milliseconds (604800000 = 7 days)
JWT_EXPIRY=604800000

# ── URLs ──────────────────────────────────────────────────────────────────────
# Origin that browsers use to reach the FRONTEND (used by backend CORS policy).
FRONTEND_URL=http://localhost:3000

# URL the backend embeds in uploaded-file responses (must be browser-reachable).
BACKEND_URL=http://localhost:8080

# URL the frontend (browser) calls to reach the backend API.
# This is baked into the JS bundle at Docker build time.
VITE_BACKEND_URL=http://localhost:8080
